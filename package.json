{
  "name": "calendar-widget",
  "version": "0.1.0",
  "description": "Windows 바탕화면에 반투명하게 띄우는 업무용 월간 플래너",
  "main": "./out/main/index.js",
  "author": "taehyeon.jeong",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@fontsource/jua": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@3.2.1": true
  }
}
